<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/header.jspf" %><section class="panel pad form-card"><p class="muted">공용 작품 정보입니다. 작품은 모든 회원이 사용하고, 감상 기록은 개인별로 저장됩니다.</p><c:if test="${not empty duplicates}"><div class="notice"><strong>같은 제목의 작품을 확인해 주세요.</strong><ul><c:forEach items="${duplicates}" var="d"><li><a class="link" href="<c:url value='/works/${d.id}'/>"><c:out value="${d.title}"/> (<c:out value="${d.releaseYear}" default="연도 미지정"/>)</a></li></c:forEach></ul></div></c:if><c:choose><c:when test="${editing}"><c:url var="workAction" value="/admin/works/${workId}"/></c:when><c:otherwise><c:url var="workAction" value="/works"/></c:otherwise></c:choose><form action="<c:out value='${workAction}'/>" method="post" data-progress novalidate><%@ include file="common/csrf.jspf" %><div class="field"><label for="title">제목 <span class="required">필수</span></label><input id="title" name="title" maxlength="200" required value="<c:out value='${workForm.title}'/>"></div><div class="two-column"><div class="field"><label for="mediaType">유형</label><select id="mediaType" name="mediaType"><option value="MOVIE" ${workForm.mediaType=='MOVIE'?'selected':''}>영화</option><option value="TV" ${workForm.mediaType=='TV'?'selected':''}>드라마</option></select></div><div class="field"><label for="releaseYear">공개 연도 <span class="optional">선택</span></label><input id="releaseYear" name="releaseYear" type="number" min="1888" max="2100" value="<c:out value='${workForm.releaseYear}'/>"></div></div><fieldset class="field"><legend>장르 <span class="optional">여러 개 선택 가능</span></legend><div class="checkbox-grid"><c:forEach items="${genres}" var="g"><c:set var="chosen" value="false"/><c:forEach items="${workForm.genreIds}" var="selected"><c:if test="${selected==g.id}"><c:set var="chosen" value="true"/></c:if></c:forEach><label class="check"><input type="checkbox" name="genreIds" value="${g.id}" ${chosen?'checked':''}><c:out value="${g.name}"/></label></c:forEach></div></fieldset><div class="field"><label for="synopsis">작품 소개 <span class="optional">선택</span></label><textarea id="synopsis" name="synopsis" maxlength="1000" rows="4"><c:out value="${workForm.synopsis}"/></textarea><small>1,000자 이내의 일반 텍스트</small></div><c:if test="${not editing}"><label class="check duplicate-check"><input name="confirmDuplicate" type="checkbox" value="true" ${workForm.confirmDuplicate?'checked':''}>같은 제목의 기존 작품을 확인했으며 별개 작품으로 등록합니다.</label></c:if><div class="form-actions"><button class="button" type="submit"><c:out value="${editing?'공용 작품 수정':'작품 등록'}"/></button><a class="button secondary" href="<c:url value='/works'/>">취소</a></div></form></section><%@ include file="common/footer.jspf" %>
