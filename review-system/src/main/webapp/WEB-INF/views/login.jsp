<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/header.jspf" %><section class="auth-card panel pad"><span class="eyebrow">WELCOME BACK</span><h2>나만의 기록으로 돌아오세요.</h2><p class="muted">로그인하면 감상 기록과 현재 상태를 이어서 볼 수 있어요.</p><c:if test="${param.error!=null}"><div class="notice error" role="alert">아이디 또는 비밀번호를 확인하세요.</div></c:if><c:if test="${param.logout!=null}"><div class="notice success" role="status">로그아웃했습니다.</div></c:if><c:if test="${param.registered!=null}"><div class="notice success" role="status">회원가입이 완료되었습니다. 로그인해 주세요.</div></c:if>
<form action="<c:url value='/login'/>" method="post" data-progress><%@ include file="common/csrf.jspf" %><div class="field"><label for="username">아이디</label><input id="username" name="username" value="<c:out value='${loginUsername}'/>" autocomplete="username" required maxlength="40" autofocus></div><div class="field"><label for="password">비밀번호</label><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="72"></div><button class="button full" type="submit">로그인</button></form><p class="auth-bottom">처음 방문하셨나요? <a class="link" href="<c:url value='/signup'/>">회원가입</a></p></section><%@ include file="common/footer.jspf" %>
