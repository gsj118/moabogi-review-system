<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/header.jspf" %><section class="panel pad"><p class="muted">체크한 장르가 붙은 작품은 <strong>작품 찾기(목록·검색)</strong>에서 보이지 않아요. 이미 남긴 감상 기록과 통계에는 영향이 없어요. 내 설정이라 다른 회원에게는 적용되지 않아요.</p><form action="<c:url value='/settings/genres'/>" method="post" data-progress><%@ include file="common/csrf.jspf" %><fieldset class="field"><legend>작품 목록에서 숨길 장르</legend><c:forEach items="${genres}" var="g"><label class="choice"><input type="checkbox" name="hide" value="${g.id}" ${hiddenIds.contains(g.id)?'checked':''}><span><strong><c:out value="${g.name}"/></strong></span></label></c:forEach></fieldset><div class="form-actions"><button class="button" type="submit">저장</button><a class="button secondary" href="<c:url value='/works'/>">작품 찾기로 돌아가기</a></div></form></section><%@ include file="common/footer.jspf" %>
