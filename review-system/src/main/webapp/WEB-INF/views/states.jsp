<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/header.jspf" %><p class="page-description">현재의 계획과 시청 상태를 관리해요. 감상 기간과 독립적인 현재 시점의 상태입니다.</p><form class="panel pad inline-form filters" method="get" action="<c:url value='/states'/>"><label for="status">현재 상태</label><select id="status" name="status"><option value="">모든 상태</option><c:forEach items="${stateLabels}" var="s"><option value="${s.key}" ${selectedState==s.key?'selected':''}><c:out value="${s.value}"/></option></c:forEach></select><button class="button" type="submit">조회하기</button></form><section class="panel"><c:choose><c:when test="${empty states}"><div class="empty"><h2>이 상태의 작품이 아직 없어요.</h2><p>작품 상세에서 ‘보고 싶음’ 등 현재 상태를 지정해 주세요.</p><a class="button" href="<c:url value='/works'/>">작품 찾기</a></div></c:when><c:otherwise><div class="table-wrap"><table><caption class="sr-only">현재 시청 상태별 작품</caption><thead><tr><th>작품</th><th>현재 상태</th><th>변경일시</th><th>관리</th></tr></thead><tbody><c:forEach items="${states}" var="s"><tr><td><strong><c:out value="${s.title}"/></strong><small class="muted"><c:out value="${s.mediaType=='MOVIE'?'영화':'드라마'}"/></small></td><td><span class="pill"><c:out value="${stateLabels[s.status]}"/></span></td><td><c:out value="${s.updatedAt}"/></td><td><a class="link" href="<c:url value='/works/${s.workId}'/>">상태와 이력 →</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section><%@ include file="common/footer.jspf" %>
