<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/header.jspf" %><section class="panel pad"><p class="muted">공용 장르의 수정은 모든 작품과 장르 통계에 반영됩니다. 연결된 장르는 삭제할 수 없습니다.</p><form class="inline-form" action="<c:url value='/admin/genres'/>" method="post" data-progress><%@ include file="common/csrf.jspf" %><label for="newGenre">새 장르명</label><input id="newGenre" name="name" maxlength="40" required><button class="button" type="submit">장르 등록</button></form><div class="genre-admin"><c:forEach items="${genres}" var="g"><div><form class="inline-form" action="<c:url value='/admin/genres/${g.id}'/>" method="post"><%@ include file="common/csrf.jspf" %><label for="genre-${g.id}" class="sr-only">장르명 수정</label><input id="genre-${g.id}" name="name" maxlength="40" value="<c:out value='${g.name}'/>"><button class="button secondary small" type="submit">수정</button></form><form action="<c:url value='/admin/genres/${g.id}/delete'/>" method="post" data-confirm="이 공용 장르를 삭제할까요?"><%@ include file="common/csrf.jspf" %><button class="text-button danger" type="submit">삭제</button></form></div></c:forEach></div></section><%@ include file="common/footer.jspf" %>
