<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${empty records}"><div class="empty"><span aria-hidden="true">▤</span><h3>아직 이 조건의 감상 기록이 없어요.</h3><p>날짜·장르 조건을 비우거나 작품을 골라 감상을 남겨보세요.</p><div class="form-actions"><c:if test="${not empty listPath}"><a class="button secondary" href="<c:url value='${listPath}'/>">조회 조건 초기화</a></c:if><c:choose><c:when test="${not empty work}"><a class="button" href="<c:out value='${completeUrl}'/>">이 작품 감상 남기기</a></c:when><c:otherwise><a class="button" href="<c:url value='/works'/>">작품 찾기</a></c:otherwise></c:choose></div></div></c:when><c:otherwise><div class="table-wrap record-table"><table><caption class="sr-only">나의 감상 기록 목록. 감상 순서와 평점 변화는 전체 이력 기준.</caption><thead><tr><th scope="col">작품</th><th scope="col">감상일</th><th scope="col">평점</th><th scope="col">감상 순서</th><th scope="col">기록</th></tr></thead><tbody><c:forEach items="${records}" var="r"><tr>
<td class="record-work"><a class="table-title" href="<c:url value='/works/${r.workId}'/>"><c:out value="${r.title}"/></a><small class="muted"><c:out value="${r.mediaType=='MOVIE'?'영화':'드라마'}"/> · <c:out value="${r.genreNames}" default="장르 미지정"/></small></td>
<td data-label="감상일"><time datetime="${r.viewedOn}"><c:out value="${r.viewedOn}"/></time></td><td data-label="평점"><c:choose><c:when test="${r.rating!=null}"><span class="rating">★ <fmt:formatNumber value="${r.rating}" pattern="0.0"/></span><%@ include file="rating-change.jspf" %></c:when><c:otherwise><span class="muted">미평점</span></c:otherwise></c:choose></td>
<td data-label="감상 순서"><span class="pill ${r.viewingOrder>1?'warm':''}"><c:out value="${r.viewingOrder>1?'재감상':'첫 기록'}"/></span><small class="muted"><c:out value="${r.viewingOrder}"/>번째 기록</small></td><td class="record-open"><a class="link" href="<c:url value='/records/${r.id}'/>">상세 보기 →<span class="sr-only"> <c:out value="${r.title}"/> <c:out value="${r.viewedOn}"/> <c:out value="${r.viewingOrder}"/>번째</span></a></td>
</tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
