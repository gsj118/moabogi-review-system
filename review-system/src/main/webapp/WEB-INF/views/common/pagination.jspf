<%@ page pageEncoding="UTF-8" %>
<c:set var="pages" value="${total==0?1:((total-total%filter.size)/filter.size+(total%filter.size>0?1:0))}"/><nav class="pagination" aria-label="페이지 이동"><span>총 <strong><c:out value="${total}"/></strong><c:out value="${listPath=='/works'?'개 작품':'건 기록'}"/> · <c:out value="${filter.page}"/> / <fmt:formatNumber value="${pages}" maxFractionDigits="0"/> 페이지</span><div>
<c:if test="${filter.page>1}"><c:url var="prevUrl" value="${listPath}"><c:param name="page" value="${filter.page-1}"/><c:param name="keyword" value="${filter.keyword}"/><c:param name="mediaType" value="${filter.mediaType}"/><c:param name="genreId" value="${filter.genreId}"/><c:param name="from" value="${filter.from}"/><c:param name="to" value="${filter.to}"/><c:param name="sort" value="${filter.sort}"/><c:param name="workId" value="${filter.workId}"/></c:url><a class="button secondary small" href="<c:out value='${prevUrl}'/>">← 이전</a></c:if>
<c:if test="${filter.page<pages}"><c:url var="nextUrl" value="${listPath}"><c:param name="page" value="${filter.page+1}"/><c:param name="keyword" value="${filter.keyword}"/><c:param name="mediaType" value="${filter.mediaType}"/><c:param name="genreId" value="${filter.genreId}"/><c:param name="from" value="${filter.from}"/><c:param name="to" value="${filter.to}"/><c:param name="sort" value="${filter.sort}"/><c:param name="workId" value="${filter.workId}"/></c:url><a class="button secondary small" href="<c:out value='${nextUrl}'/>">다음 →</a></c:if></div></nav>
