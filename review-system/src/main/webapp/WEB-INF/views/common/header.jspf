<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %>
<%@ taglib uri="http://www.springframework.org/security/tags" prefix="sec" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><c:out value="${pageTitle}"/> · 모아보기</title><link rel="stylesheet" href="<c:url value='/resources/css/app.css'/>"><script defer src="<c:url value='/resources/js/app.js'/>"></script></head>
<body><a class="skip-link" href="#content">본문으로 이동</a><div class="app-shell"><aside class="sidebar"><a class="brand" href="<c:url value='/'/>"><span class="brand-mark" aria-hidden="true">m.</span><span>모아보기<small>나의 감상 기록</small></span></a>
<sec:authorize access="isAuthenticated()"><p class="nav-caption">MY JOURNAL</p><nav aria-label="주요 메뉴"><a href="<c:url value='/'/>">◈ <span>나의 감상 공간</span></a><a href="<c:url value='/works'/>">▤ <span>작품 찾기</span></a><a href="<c:url value='/records'/>">▦ <span>감상 기록</span></a><a href="<c:url value='/states'/>">◷ <span>현재 시청 상태</span></a><a href="<c:url value='/stats'/>">▥ <span>통계와 취향</span></a><sec:authorize access="hasRole('ADMIN')"><a href="<c:url value='/admin/genres'/>">⚙ <span>공용 장르 관리</span></a></sec:authorize></nav><div class="sidebar-note"><span class="eyebrow">YOUR OWN STORY</span><p>좋았던 순간도,<br>달라진 생각도.<br>기록하면 오래 남아요.</p></div><div class="account"><sec:authentication property="principal.displayName" var="memberName"/><span class="avatar" aria-hidden="true">나</span><div><strong><c:out value="${memberName}"/></strong><small>나만의 감상 공간</small></div><form action="<c:url value='/logout'/>" method="post"><%@ include file="csrf.jspf" %><button class="text-button" type="submit">로그아웃</button></form></div></sec:authorize>
<sec:authorize access="!isAuthenticated()"><div class="sidebar-note"><span class="eyebrow">KEEP THE MOMENT</span><p>한 편의 작품,<br>하나의 기억.<br>나만의 취향을 쌓아보세요.</p></div></sec:authorize></aside><main id="content" class="main"><header class="topbar"><span>영화 · 드라마 감상 저널</span><sec:authorize access="isAuthenticated()"><a class="button small" href="<c:url value='/works'/>">＋ 감상 남기기</a></sec:authorize></header><div class="page-heading"><span class="eyebrow">MOA WATCH JOURNAL</span><h1><c:out value="${pageTitle}"/></h1></div>
<c:if test="${not empty success}"><div class="notice success" role="status"><c:out value="${success}"/></div></c:if><c:if test="${not empty message}"><div class="notice error" role="alert" tabindex="-1"><strong>입력 또는 요청을 확인해 주세요.</strong><p><c:out value="${message}"/></p></div></c:if>
