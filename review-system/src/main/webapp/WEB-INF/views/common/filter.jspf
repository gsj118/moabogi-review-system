<%@ page pageEncoding="UTF-8" %>
<div class="filter-grid"><div class="field"><label for="keyword">작품 제목</label><input id="keyword" name="keyword" maxlength="200" placeholder="기억하고 싶은 작품을 찾아보세요" value="<c:out value='${filter.keyword}'/>"></div><div class="field"><label for="mediaType">작품 유형</label><select id="mediaType" name="mediaType"><option value="">전체</option><option value="MOVIE" ${filter.mediaType=='MOVIE'?'selected':''}>영화</option><option value="TV" ${filter.mediaType=='TV'?'selected':''}>드라마</option></select></div><div class="field"><label for="genreId">장르</label><select id="genreId" name="genreId"><option value="0">모든 장르</option><c:forEach items="${genres}" var="g"><option value="${g.id}" ${filter.genreId==g.id?'selected':''}><c:out value="${g.name}"/></option></c:forEach></select></div>
<c:if test="${listPath!='/works'}"><div class="field filter-date"><label for="from">시작일</label><input id="from" name="from" type="date" value="<c:out value='${filter.from}'/>"></div><div class="field filter-date"><label for="to">종료일</label><input id="to" name="to" type="date" value="<c:out value='${filter.to}'/>"></div></c:if>
<c:if test="${listPath=='/records'}"><div class="field"><label for="sort">정렬</label><select id="sort" name="sort"><option value="recent" ${filter.sort=='recent'?'selected':''}>최근 감상순</option><option value="oldest" ${filter.sort=='oldest'?'selected':''}>오래된 감상순</option><option value="rating" ${filter.sort=='rating'?'selected':''}>높은 평점순</option></select></div></c:if><button class="button" type="submit">조회하기</button></div>

<div class="filter-footer"><span class="muted small-text">모든 조건을 함께 적용합니다.<c:if test="${listPath!='/works'}"> 시작일·종료일을 모두 포함해요.</c:if></span><c:choose><c:when test="${empty listPath}"><a class="link" href="<c:url value='/stats'/>">조회 조건 초기화</a></c:when><c:otherwise><a class="link" href="<c:url value='${listPath}'/>">조회 조건 초기화</a></c:otherwise></c:choose></div>
<c:if test="${listPath!='/works' && filter.workId>0}"><input type="hidden" name="workId" value="${filter.workId}"></c:if>
<%@ include file="applied-filters.jspf" %>
