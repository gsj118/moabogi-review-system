<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.mnu.mapper.AccountMapper">
  <select id="byUsername" resultType="map">SELECT id,username,password_hash AS passwordHash,name,email,role FROM app_user WHERE username=#{username}</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO app_user(username,password_hash,name,email,role) VALUES(#{username},#{passwordHash},#{name},#{email},'USER')</insert>
</mapper>
